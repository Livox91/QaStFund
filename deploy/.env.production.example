# Use ":80" for a temporary HTTP-by-IP deployment. Replace it with the final
# domain (for example, lend.example.com) to enable Caddy-managed HTTPS.
SITE_ADDRESS=":80"

POSTGRES_DB="employee_lending"
POSTGRES_USER="employee_lending"
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD="replace-with-a-random-hex-value"

# Must exactly match the public origin. Use http://PUBLIC_IP during the
# temporary IP-only stage, then replace it with https://YOUR_DOMAIN.
APP_URL="http://replace-with-public-ip"

EMAIL_PROVIDER="smtp"
EMAIL_FROM="QastFund <no-reply@example.com>"
EMAIL_SMTP_HOST="smtp.example.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_SECURE="true"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""

RATE_LIMIT_ENABLED="true"
# Generate with: openssl rand -hex 32
RATE_LIMIT_HASH_SECRET="replace-with-a-separate-random-hex-value"
RATE_LIMIT_TRUST_PROXY="true"
RATE_LIMIT_TRUSTED_PROXY_HOPS="1"
RATE_LIMIT_WINDOW_SECONDS="300"
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_PUBLIC_MAX="20"
RATE_LIMIT_SENSITIVE_MAX="10"
RATE_LIMIT_ADMIN_MAX="20"
RATE_LIMIT_EXPENSIVE_MAX="10"

ARC_CHAIN_ID="5042002"
ARC_RPC_URL="https://rpc.testnet.arc.io"
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=""
NEXT_PUBLIC_CIRCLE_CLIENT_URL="https://modular-sdk.circle.com/v1/rpc/w3s/buidl"
NEXT_PUBLIC_ARC_LENDING_CONTRACT_ADDRESS=""
ARC_BORROW_AUTHORIZER_PRIVATE_KEY=""

ARC_RECONCILIATION_ENABLED="false"
ARC_RECONCILIATION_RPC_URL="https://rpc.testnet.arc.io"
ARC_RECONCILIATION_START_BLOCK="0"
ARC_RECONCILIATION_CONFIRMATIONS="5"
ARC_RECONCILIATION_BLOCK_RANGE="1000"
ARC_RECONCILIATION_REORG_WINDOW="20"
ARC_RECONCILIATION_MAX_RANGES="10"
ARC_RECONCILIATION_RPC_RETRIES="3"
ARC_RECONCILIATION_STALE_AFTER_MINUTES="15"
ARC_RECONCILIATION_INTERVAL_SECONDS="60"
ARC_RECONCILIATION_CRON_SECRET=""

# Optional generic JSON webhook. Without it, alert transitions are emitted once
# to structured container logs. Generate a dedicated bearer token if required
# by the receiver; neither value is ever included in application logs.
OPERATIONAL_ALERT_WEBHOOK_URL=""
OPERATIONAL_ALERT_WEBHOOK_BEARER_TOKEN=""
# Dedicated bearer secret for /api/health/dependencies. Generate separately
# from scheduler and webhook secrets; use at least 32 random characters.
OPERATIONAL_HEALTH_SECRET=""

OBSERVABILITY_FAILURE_ALERT_THRESHOLD="3"
OBSERVABILITY_UNMATCHED_EVENT_ALERT_THRESHOLD="10"
OBSERVABILITY_TRANSACTION_STALE_AFTER_MINUTES="15"
OBSERVABILITY_SCHEDULER_GRACE_SECONDS="120"
OBSERVABILITY_ALERT_RETRY_MINUTES="5"
LOAN_DECISION_PROVIDER="rules"
EMPLOYER_ACTION_PROVIDER="mock"

ERP_NEXT_ALLOW_LOCAL_HTTP="false"
ERP_NEXT_CREDENTIAL_ENCRYPTION_KEY=""
# Server-only JSON keyed by organization UUID; use a dedicated payroll identity.
ERP_NEXT_PAYROLL_CREDENTIALS_JSON=""
ERP_NEXT_PAYROLL_MAX_AGE_DAYS="45"
ERP_NEXT_SYNC_ENABLED="false"
ERP_NEXT_SYNC_INTERVAL_MINUTES="1440"
ERP_NEXT_ELIGIBILITY_MAX_AGE_MINUTES="1500"
ERP_NEXT_SYNC_STALE_AFTER_MINUTES="30"
ERP_NEXT_SYNC_PAGE_SIZE="100"
ERP_NEXT_SYNC_MAX_PAGES="100"
ERP_NEXT_SYNC_CRON_SECRET=""
REPAYMENT_OPERATIONS_CRON_SECRET=""
REPAYMENT_OPERATIONS_INTERVAL_MINUTES="60"
REPAYMENT_GRACE_HOURS="24"
REPAYMENT_FOLLOW_UP_DAYS="7"
REPAYMENT_ESCALATION_DAYS="14"

ARC_ESCROW_VERSION="1"
REPAYMENT_AGENT_ENABLED="false"
ARC_REPAYMENT_AGENT_PRIVATE_KEY=""
