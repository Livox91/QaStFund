DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_lending?schema=public"
APP_URL="http://localhost:3000"

# Public Circle Modular Wallet SDK identifiers. Configure the same APP_URL
# hostname as the Passkey Domain in Circle Console (localhost for local dev).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=""
NEXT_PUBLIC_CIRCLE_CLIENT_URL="https://modular-sdk.circle.com/v1/rpc/w3s/buidl"

# Deployed EmployeeLendingEscrow address on Arc Testnet. It is public and used
# by both the browser and server-side receipt verification.
NEXT_PUBLIC_ARC_LENDING_CONTRACT_ADDRESS=""

# Deployment only. Never expose this variable to the browser or commit a value.
ARC_DEPLOYER_PRIVATE_KEY=""
