DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_lending?schema=public"
APP_URL="http://localhost:3000"

# Public Circle Modular Wallet SDK identifiers. Configure the same APP_URL
# hostname as the Passkey Domain in Circle Console (localhost for local dev).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=""
NEXT_PUBLIC_CIRCLE_CLIENT_URL="https://modular-sdk.circle.com/v1/rpc/w3s/buidl"

# Deployed EmployeeLendingEscrow address on Arc Testnet. It is public and used
# by both the browser and server-side receipt verification.
NEXT_PUBLIC_ARC_LENDING_CONTRACT_ADDRESS=""

# Server-only EIP-712 signer used to authorize eligible borrowers. Store this
# in a managed secret store outside local development. Never use NEXT_PUBLIC_.
ARC_BORROW_AUTHORIZER_PRIVATE_KEY=""

# Deployment-only public address derived from the authorizer key above. The
# deployed contract stores this address immutably; changing it requires a new
# deployment.
ARC_BORROW_AUTHORIZER_ADDRESS=""

# Deployment only. Never expose this variable to the browser or commit a value.
ARC_DEPLOYER_PRIVATE_KEY=""

# Restartable Arc event reconciliation. Set START_BLOCK to the escrow deployment
# block so the first run does not scan chain history before this contract.
ARC_RECONCILIATION_ENABLED="false"
ARC_RECONCILIATION_RPC_URL="https://rpc.testnet.arc.network"
ARC_RECONCILIATION_START_BLOCK="0"
ARC_RECONCILIATION_CONFIRMATIONS="5"
ARC_RECONCILIATION_BLOCK_RANGE="1000"
ARC_RECONCILIATION_REORG_WINDOW="20"
ARC_RECONCILIATION_MAX_RANGES="10"
ARC_RECONCILIATION_RPC_RETRIES="3"
# Required when enabled. Use at least 32 random characters.
ARC_RECONCILIATION_CRON_SECRET=""

# Decision engine implementation. "model" is reserved for the future trained
# model adapter and currently fails closed with a model-unavailable error.
LOAN_DECISION_PROVIDER="rules"

# Employer workflow adapter. Only the side-effect-free mock provider exists in
# this milestone; unknown or future providers fail startup validation.
EMPLOYER_ACTION_PROVIDER="mock"

# ERPNext Employee directory secrets are server-only and scoped by organization.
ERP_NEXT_ALLOW_LOCAL_HTTP="false"
# ERP_NEXT_CREDENTIALS_JSON='{"organization-uuid":{"primary":{"apiKey":"...","apiSecret":"..."}}}'

# Call POST /api/internal/erpnext-sync from an external cron at least this often.
# The application applies the per-organization due-time gate.
ERP_NEXT_SYNC_ENABLED="false"
ERP_NEXT_SYNC_INTERVAL_MINUTES="1440"
ERP_NEXT_SYNC_STALE_AFTER_MINUTES="30"
# Required when ERP_NEXT_SYNC_ENABLED=true. Use at least 32 random characters.
ERP_NEXT_SYNC_CRON_SECRET=""
