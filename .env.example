DATABASE_URL="postgresql://postgres:postgres@localhost:5432/employee_lending?schema=public"
APP_URL="http://localhost:3000"

# Local-chain integration only. `npm run chain:test` supplies these values from
# its isolated deployment manifest automatically. For a manually managed local
# node, copy the current addresses from the generated deployments/local.json.
CHAIN_ENV="local"
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="31337"
USDC_ADDRESS=""
LENDING_CONTRACT_ADDRESS=""

# HTTPS endpoint for the application's email gateway. It receives JSON with
# from, to, subject, text, and html. The bearer token is server-only.
EMAIL_DELIVERY_ENDPOINT=""
EMAIL_DELIVERY_TOKEN=""
EMAIL_FROM="Employee Lending <no-reply@example.com>"
# Use "smtp" to send through a personal Gmail account instead of the HTTP provider.
EMAIL_PROVIDER="http"
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_SECURE="true"
EMAIL_SMTP_USER=""
# Gmail requires a 16-character App Password, never your normal account password.
EMAIL_SMTP_PASSWORD=""

# Shared PostgreSQL-backed request limiting. Set a dedicated random secret in
# deployed environments; local development falls back to DATABASE_URL as the
# HMAC key. Trust forwarded IP headers only behind a controlled reverse proxy.
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_HASH_SECRET=""
RATE_LIMIT_TRUST_PROXY="false"
RATE_LIMIT_TRUSTED_PROXY_HOPS="1"
RATE_LIMIT_WINDOW_SECONDS="300"
RATE_LIMIT_AUTH_MAX="5"
RATE_LIMIT_PUBLIC_MAX="20"
RATE_LIMIT_SENSITIVE_MAX="10"
RATE_LIMIT_ADMIN_MAX="20"
RATE_LIMIT_EXPENSIVE_MAX="10"

# Arc Testnet functionality is validated only when that feature is used.
ARC_CHAIN_ID="5042002"
ARC_RPC_URL="https://rpc.testnet.arc.network"
ARC_USDC_ADDRESS="0x3600000000000000000000000000000000000000"

# Public Circle Modular Wallet SDK identifiers. Configure the same APP_URL
# hostname as the Passkey Domain in Circle Console (localhost for local dev).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=""
NEXT_PUBLIC_CIRCLE_CLIENT_URL="https://modular-sdk.circle.com/v1/rpc/w3s/buidl"

# Deployed EmployeeLendingEscrow address on Arc Testnet. It is public and used
# by both the browser and server-side receipt verification.
NEXT_PUBLIC_ARC_LENDING_CONTRACT_ADDRESS=""

# Server-only EIP-712 signer used to authorize eligible borrowers. Store this
# in a managed secret store outside local development. Never use NEXT_PUBLIC_.
ARC_BORROW_AUTHORIZER_PRIVATE_KEY=""

# Deployment-only public address derived from the authorizer key above. The
# deployed contract stores this address immutably; changing it requires a new
# deployment.
ARC_BORROW_AUTHORIZER_ADDRESS=""

# Deployment only. Never expose this variable to the browser or commit a value.
ARC_DEPLOYER_PRIVATE_KEY=""

# Optional receipt provenance emitted by the deployment command and verified by
# the pilot preflight when present.
ARC_ESCROW_DEPLOYMENT_TRANSACTION_HASH=""

# Restartable Arc event reconciliation. Set START_BLOCK to the escrow deployment
# block so the first run does not scan chain history before this contract.
ARC_RECONCILIATION_ENABLED="false"
ARC_RECONCILIATION_RPC_URL="https://rpc.testnet.arc.network"
ARC_RECONCILIATION_START_BLOCK="0"
ARC_RECONCILIATION_CONFIRMATIONS="5"
ARC_RECONCILIATION_BLOCK_RANGE="1000"
ARC_RECONCILIATION_REORG_WINDOW="20"
ARC_RECONCILIATION_MAX_RANGES="10"
ARC_RECONCILIATION_RPC_RETRIES="3"
ARC_RECONCILIATION_STALE_AFTER_MINUTES="15"
OBSERVABILITY_FAILURE_ALERT_THRESHOLD="3"
OBSERVABILITY_UNMATCHED_EVENT_ALERT_THRESHOLD="10"
# Required when enabled. Use at least 32 random characters.
ARC_RECONCILIATION_CRON_SECRET=""

# Decision engine implementation. "model" is reserved for the future trained
# model adapter and currently fails closed with a model-unavailable error.
LOAN_DECISION_PROVIDER="rules"

# Employer workflow adapter. Only the side-effect-free mock provider exists in
# this milestone; unknown or future providers fail startup validation.
EMPLOYER_ACTION_PROVIDER="mock"

# ERPNext is optional while scheduled synchronization is disabled. Credentials
# are server-only and scoped by organization.
ERP_NEXT_ALLOW_LOCAL_HTTP="false"
# Required to save ERPNext credentials from the employer UI. Generate once with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Keep the value stable across restarts. Rotating it requires re-entering credentials.
ERP_NEXT_CREDENTIAL_ENCRYPTION_KEY=""
# Legacy/operator-managed credential source. The employer UI does not need this.
# ERP_NEXT_CREDENTIALS_JSON='{"organization-uuid":{"primary":{"apiKey":"...","apiSecret":"..."}}}'

# Call POST /api/internal/erpnext-sync from an external cron at least this often.
# The application applies the per-organization due-time gate.
ERP_NEXT_SYNC_ENABLED="false"
ERP_NEXT_SYNC_INTERVAL_MINUTES="1440"
ERP_NEXT_SYNC_STALE_AFTER_MINUTES="30"
# Each ERPNext request is bounded, and a runaway cursor cannot exceed this many pages.
ERP_NEXT_SYNC_PAGE_SIZE="100"
ERP_NEXT_SYNC_MAX_PAGES="100"
# Required when ERP_NEXT_SYNC_ENABLED=true. Use at least 32 random characters.
ERP_NEXT_SYNC_CRON_SECRET=""
