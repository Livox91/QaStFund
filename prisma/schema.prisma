  maxPerPeriodBaseUnits    BigInt
  minimumReserveBaseUnits  BigInt
  periodSeconds            Int
  earliestBeforeDueSeconds Int
  expiresAt                DateTime
  allowanceBaseUnits       BigInt
  status                   RepaymentAgentMandateStatus @default(PENDING)
  transactionHash          String?                     @unique @db.VarChar(66)
  activatedAt              DateTime?
  revokedAt                DateTime?
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt
  organization             Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  borrowerMembership       OrganizationMembership      @relation(fields: [organizationId, borrowerMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, borrowerMembershipId, status])
  @@index([status])
}

