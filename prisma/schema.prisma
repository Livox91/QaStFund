generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  EMPLOYER_ADMIN
  EMPLOYEE
}

enum LendingOfferStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXHAUSTED
}

enum LoanStatus {
  REQUESTED
  APPROVED
  ACTIVE
  REPAID
  OVERDUE
  DEFAULTED
  CANCELLED
}

enum AuditEventType {
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_CREATED
  LOAN_ACTIVATED
  REPAYMENT_RECORDED
  REPAYMENT_CREATED
  REPAYMENT_COMPLETED
  LOAN_REPAID
  LOAN_OVERDUE
  LOAN_DEFAULTED
  LOAN_CANCELLED
  LOAN_MARKED_OVERDUE
  LENDING_POLICY_UPDATED
  EMPLOYEE_BORROWING_SUSPENDED
  EMPLOYEE_BORROWING_ENABLED
  EMPLOYEE_LENDING_SUSPENDED
  EMPLOYEE_LENDING_ENABLED
}

enum RepaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum LedgerAccountType {
  USER_WALLET
  PLATFORM
}

enum LedgerTransactionType {
  DEPOSIT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  WITHDRAWAL
}

enum LedgerTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerReferenceType {
  DEVELOPMENT_FUNDING
  LOAN
  REPAYMENT
  WITHDRAWAL
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

model User {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique
  name         String
  passwordHash String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganizationMembership[]
}

model Organization {
  id                 String                     @id @default(uuid()) @db.Uuid
  name               String
  slug               String                     @unique
  currency           String                     @default("USD") @db.VarChar(3)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  memberships        OrganizationMembership[]
  lendingOffers      LendingOffer[]
  loans              Loan[]
  repayments         LoanRepayment[]
  auditEvents        AuditEvent[]
  balances           EmployeeBalance[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
  lendingPolicy      OrganizationLendingPolicy?
}

model OrganizationMembership {
  id                  String           @id @default(uuid()) @db.Uuid
  organizationId      String           @db.Uuid
  userId              String           @db.Uuid
  role                MembershipRole
  isActive            Boolean          @default(true)
  canBorrow           Boolean          @default(true)
  canLend             Boolean          @default(true)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  organization        Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions            Session[]
  lendingOffers       LendingOffer[]   @relation("MembershipLendingOffers")
  balance             EmployeeBalance?
  loansAsLender       Loan[]           @relation("LoansAsLender")
  loansAsBorrower     Loan[]           @relation("LoansAsBorrower")
  ledgerAccounts      LedgerAccount[]
  auditEventsActed    AuditEvent[]     @relation("AuditEventActor")
  auditEventsTargeted AuditEvent[]     @relation("AuditEventTarget")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
}

model LendingOffer {
  id                          String                 @id @default(uuid()) @db.Uuid
  organizationId              String                 @db.Uuid
  lenderMembershipId          String                 @db.Uuid
  amountMinorUnits            BigInt
  availableAmountMinorUnits   BigInt
  minimumLoanAmountMinorUnits BigInt
  maximumLoanAmountMinorUnits BigInt
  currency                    String                 @db.VarChar(3)
  durationDays                Int
  feeRateBasisPoints          Int
  expiresAt                   DateTime
  status                      LendingOfferStatus
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  organization                Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership            OrganizationMembership @relation("MembershipLendingOffers", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  loans                       Loan[]
  auditEvents                 AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, lenderMembershipId])
}

model EmployeeBalance {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  membershipId     String                 @db.Uuid
  amountMinorUnits BigInt
  currency         String                 @db.VarChar(3)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership       OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@index([organizationId])
}

model Loan {
  id                             String                 @id @default(uuid()) @db.Uuid
  organizationId                 String                 @db.Uuid
  lenderMembershipId             String                 @db.Uuid
  borrowerMembershipId           String                 @db.Uuid
  lendingOfferId                 String?                @db.Uuid
  borrowRequestId                String?                @unique @db.Uuid
  principalAmountMinorUnits      BigInt
  feeAmountMinorUnits            BigInt                 @default(0)
  outstandingPrincipalMinorUnits BigInt
  currency                       String                 @db.VarChar(3)
  durationDays                   Int
  feeRateBasisPoints             Int
  status                         LoanStatus
  requestedAt                    DateTime               @default(now())
  approvedAt                     DateTime?
  activatedAt                    DateTime?
  closedAt                       DateTime?
  startedAt                      DateTime               @default(now())
  repaymentDueAt                 DateTime
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  policyVersion                  Int?
  policySnapshot                 Json?
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership               OrganizationMembership @relation("LoansAsLender", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  borrowerMembership             OrganizationMembership @relation("LoansAsBorrower", fields: [organizationId, borrowerMembershipId], references: [organizationId, id], onDelete: Restrict)
  lendingOffer                   LendingOffer?          @relation(fields: [organizationId, lendingOfferId], references: [organizationId, id], onDelete: Restrict)
  repayments                     LoanRepayment[]
  auditEvents                    AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, repaymentDueAt])
  @@index([organizationId, lenderMembershipId])
  @@index([organizationId, borrowerMembershipId])
  @@index([organizationId, lenderMembershipId, status])
  @@index([organizationId, borrowerMembershipId, status])
}

model LedgerAccount {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  membershipId   String?                 @db.Uuid
  asset          String                  @db.VarChar(8)
  type           LedgerAccountType
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership? @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@unique([organizationId, membershipId, asset, type])
  @@unique([organizationId, id])
  @@index([organizationId, membershipId])
}

model LedgerTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  type           LedgerTransactionType
  status         LedgerTransactionStatus @default(PENDING)
  referenceType  LedgerReferenceType
  referenceId    String                  @db.Uuid
  idempotencyKey String                  @db.VarChar(128)
  createdAt      DateTime                @default(now())
  completedAt    DateTime?
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        LedgerEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, referenceType, referenceId, type])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, createdAt])
}

model LedgerEntry {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  transactionId    String               @db.Uuid
  accountId        String               @db.Uuid
  direction        LedgerEntryDirection
  amountMinorUnits BigInt
  asset            String               @db.VarChar(8)
  createdAt        DateTime             @default(now())
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction      LedgerTransaction    @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)
  account          LedgerAccount        @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([organizationId, transactionId])
  @@index([organizationId, accountId])
}

model LoanRepayment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  loanId             String          @db.Uuid
  repaymentRequestId String?         @unique @db.Uuid
  amountMinorUnits   BigInt
  currency           String          @db.VarChar(3)
  status             RepaymentStatus @default(COMPLETED)
  paidAt             DateTime
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan               Loan            @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  auditEvents        AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, loanId, paidAt])
}

model AuditEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  loanId             String?                 @db.Uuid
  lendingOfferId     String?                 @db.Uuid
  repaymentId        String?                 @db.Uuid
  actorMembershipId  String?                 @db.Uuid
  targetMembershipId String?                 @db.Uuid
  amountMinorUnits   BigInt?
  currency           String?                 @db.VarChar(3)
  type               AuditEventType
  title              String
  actorLabel         String?
  metadata           Json?
  occurredAt         DateTime
  createdAt          DateTime                @default(now())
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan               Loan?                   @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  lendingOffer       LendingOffer?           @relation(fields: [organizationId, lendingOfferId], references: [organizationId, id], onDelete: Restrict)
  repayment          LoanRepayment?          @relation(fields: [organizationId, repaymentId], references: [organizationId, id], onDelete: Restrict)
  actorMembership    OrganizationMembership? @relation("AuditEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  targetMembership   OrganizationMembership? @relation("AuditEventTarget", fields: [organizationId, targetMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, loanId, occurredAt])
  @@index([organizationId, lendingOfferId, occurredAt])
  @@index([organizationId, repaymentId, occurredAt])
  @@index([organizationId, actorMembershipId, occurredAt])
  @@index([organizationId, targetMembershipId, occurredAt])
}

model OrganizationLendingPolicy {
  id                           String       @id @default(uuid()) @db.Uuid
  organizationId               String       @unique @db.Uuid
  lendingEnabled               Boolean      @default(true)
  borrowingEnabled             Boolean      @default(true)
  maxLoanAmountMinorUnits      BigInt       @default(10000)
  maxOutstandingDebtMinorUnits BigInt       @default(25000)
  maxActiveLoans               Int          @default(3)
  minInterestRateBasisPoints   Int          @default(0)
  maxInterestRateBasisPoints   Int          @default(500)
  minTermDays                  Int          @default(7)
  maxTermDays                  Int          @default(60)
  policyVersion                Int          @default(1)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Session {
  id             String                 @id @default(uuid()) @db.Uuid
  tokenHash      String                 @unique @db.VarChar(64)
  userId         String                 @db.Uuid
  organizationId String                 @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
