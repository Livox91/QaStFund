  borrowerMembershipId  String                    @db.Uuid
  trigger               RepaymentAgentTrigger
  status                RepaymentAgentRunStatus   @default(RUNNING)
  plannerKind           RepaymentAgentPlannerKind
  plannerModel          String?                   @db.VarChar(64)
  promptVersion         String                    @db.VarChar(64)
  policyVersion         String                    @db.VarChar(64)
  inputSnapshot         Json
  decision              Json?
  outcomeCode           String?                   @db.VarChar(64)
  outcomeSummary        String?                   @db.VarChar(1000)
  requiresHumanApproval Boolean                   @default(false)
  parentRunId           String?                   @db.Uuid
  startedAt             DateTime
  completedAt           DateTime?
  createdAt             DateTime                  @default(now())
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  borrowerMembership    OrganizationMembership    @relation(fields: [organizationId, borrowerMembershipId], references: [organizationId, id], onDelete: Restrict)
  steps                 RepaymentAgentStep[]
  actions               RepaymentAgentAction[]

  @@unique([organizationId, id])
  @@index([organizationId, borrowerMembershipId, startedAt])
  @@index([status, startedAt])
}

/// Append-only activity log: every observation, tool call, policy check,
/// action, verification and adaptation, in order.
model RepaymentAgentStep {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  runId          String            @db.Uuid
  sequence       Int
  phase          String            @db.VarChar(16)
  name           String            @db.VarChar(64)
  summary        String            @db.VarChar(1000)
  data           Json
  createdAt      DateTime          @default(now())
  run            RepaymentAgentRun @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)

  @@unique([runId, sequence])
}

model RepaymentAgentAction {
  id                   String                     @id @default(uuid()) @db.Uuid
  organizationId       String                     @db.Uuid
  runId                String                     @db.Uuid
  borrowerMembershipId String                     @db.Uuid
  loanId               String                     @db.Uuid
  action               String                     @db.VarChar(32)
  amountBaseUnits      BigInt?
  status               RepaymentAgentActionStatus
  repaymentRequestId   String                     @unique @db.Uuid
  chainRepaymentId     String                     @unique @db.VarChar(66)
  mandateNonce         String?                    @db.VarChar(78)
  decision             Json
  validation           Json
  transactionHash      String?                    @unique @db.VarChar(66)
  verification         Json?
  failureCode          String?                    @db.VarChar(64)
  attempts             Int                        @default(0)
  expiresAt            DateTime?
  submittedAt          DateTime?
  confirmedAt          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  run                  RepaymentAgentRun          @relation(fields: [organizationId, runId], references: [organizationId, id], onDelete: Restrict)
  loan                 Loan                       @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, borrowerMembershipId, status])
  @@index([status, updatedAt])
}
