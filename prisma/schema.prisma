generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  EMPLOYER_ADMIN
  EMPLOYEE
}

enum LendingOfferStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum LoanStatus {
  REQUESTED
  APPROVED
  ACTIVE
  REPAID
  OVERDUE
  DEFAULTED
  CANCELLED
}

enum AuditEventType {
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_CREATED
  LOAN_ACTIVATED
  REPAYMENT_RECORDED
  LOAN_REPAID
  LOAN_OVERDUE
  LOAN_DEFAULTED
  LOAN_CANCELLED
}

enum LedgerAccountType {
  MOCK_CASH
}

enum LedgerTransactionType {
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

model User {
  id           String                   @id @default(uuid()) @db.Uuid
  email        String                   @unique
  name         String
  passwordHash String
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  memberships  OrganizationMembership[]
}

model Organization {
  id                 String                   @id @default(uuid()) @db.Uuid
  name               String
  slug               String                   @unique
  currency           String                   @default("USD") @db.VarChar(3)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  memberships        OrganizationMembership[]
  lendingOffers      LendingOffer[]
  loans              Loan[]
  repayments         LoanRepayment[]
  auditEvents        AuditEvent[]
  balances           EmployeeBalance[]
  ledgerAccounts     LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
  ledgerEntries      LedgerEntry[]
}

model OrganizationMembership {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @db.Uuid
  userId           String           @db.Uuid
  role             MembershipRole
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions         Session[]
  lendingOffers    LendingOffer[]   @relation("MembershipLendingOffers")
  balance          EmployeeBalance?
  loansAsLender    Loan[]           @relation("LoansAsLender")
  loansAsBorrower  Loan[]           @relation("LoansAsBorrower")
  ledgerAccounts   LedgerAccount[]
  auditEventsActed AuditEvent[]     @relation("AuditEventActor")

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
}

model LendingOffer {
  id                          String                 @id @default(uuid()) @db.Uuid
  organizationId              String                 @db.Uuid
  lenderMembershipId          String                 @db.Uuid
  amountMinorUnits            BigInt
  availableAmountMinorUnits   BigInt
  minimumLoanAmountMinorUnits BigInt
  maximumLoanAmountMinorUnits BigInt
  currency                    String                 @db.VarChar(3)
  durationDays                Int
  feeRateBasisPoints          Int
  expiresAt                   DateTime
  status                      LendingOfferStatus
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  organization                Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership            OrganizationMembership @relation("MembershipLendingOffers", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  loans                       Loan[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, lenderMembershipId])
}

model EmployeeBalance {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  membershipId     String                 @db.Uuid
  amountMinorUnits BigInt
  currency         String                 @db.VarChar(3)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership       OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@index([organizationId])
}

model Loan {
  id                             String                 @id @default(uuid()) @db.Uuid
  organizationId                 String                 @db.Uuid
  lenderMembershipId             String                 @db.Uuid
  borrowerMembershipId           String                 @db.Uuid
  lendingOfferId                 String?                @db.Uuid
  borrowRequestId                String?                @unique @db.Uuid
  principalAmountMinorUnits      BigInt
  feeAmountMinorUnits            BigInt                 @default(0)
  outstandingPrincipalMinorUnits BigInt
  currency                       String                 @db.VarChar(3)
  durationDays                   Int
  feeRateBasisPoints             Int
  status                         LoanStatus
  requestedAt                    DateTime               @default(now())
  approvedAt                     DateTime?
  activatedAt                    DateTime?
  closedAt                       DateTime?
  startedAt                      DateTime               @default(now())
  repaymentDueAt                 DateTime
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt
  organization                   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership               OrganizationMembership @relation("LoansAsLender", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  borrowerMembership             OrganizationMembership @relation("LoansAsBorrower", fields: [organizationId, borrowerMembershipId], references: [organizationId, id], onDelete: Restrict)
  lendingOffer                   LendingOffer?          @relation(fields: [organizationId, lendingOfferId], references: [organizationId, id], onDelete: Restrict)
  repayments                     LoanRepayment[]
  auditEvents                    AuditEvent[]
  ledgerTransactions             LedgerTransaction[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, repaymentDueAt])
  @@index([organizationId, lenderMembershipId])
  @@index([organizationId, borrowerMembershipId])
  @@index([organizationId, lenderMembershipId, status])
  @@index([organizationId, borrowerMembershipId, status])
}

model LedgerAccount {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  membershipId   String                 @db.Uuid
  currency       String                 @db.VarChar(3)
  type           LedgerAccountType
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@unique([organizationId, membershipId, currency, type])
  @@unique([organizationId, id])
  @@index([organizationId, membershipId])
}

model LedgerTransaction {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  loanId         String                @db.Uuid
  repaymentId    String?               @unique @db.Uuid
  type           LedgerTransactionType
  currency       String                @db.VarChar(3)
  createdAt      DateTime              @default(now())
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan           Loan                  @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  repayment      LoanRepayment?        @relation(fields: [organizationId, repaymentId], references: [organizationId, id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, repaymentId])
  @@index([organizationId, loanId])
  @@index([organizationId, createdAt])
}

model LedgerEntry {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  transactionId    String               @db.Uuid
  accountId        String               @db.Uuid
  direction        LedgerEntryDirection
  amountMinorUnits BigInt
  currency         String               @db.VarChar(3)
  createdAt        DateTime             @default(now())
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction      LedgerTransaction    @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)
  account          LedgerAccount        @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, transactionId])
  @@index([organizationId, accountId])
}

model LoanRepayment {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  loanId             String             @db.Uuid
  repaymentRequestId String?            @unique @db.Uuid
  amountMinorUnits   BigInt
  currency           String             @db.VarChar(3)
  paidAt             DateTime
  createdAt          DateTime           @default(now())
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan               Loan               @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  ledgerTransaction  LedgerTransaction?

  @@unique([organizationId, id])
  @@index([organizationId, loanId, paidAt])
}

model AuditEvent {
  id                String                  @id @default(uuid()) @db.Uuid
  organizationId    String                  @db.Uuid
  loanId            String                  @db.Uuid
  actorMembershipId String?                 @db.Uuid
  type              AuditEventType
  title             String
  actorLabel        String?
  occurredAt        DateTime
  createdAt         DateTime                @default(now())
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan              Loan                    @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  actorMembership   OrganizationMembership? @relation("AuditEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, loanId, occurredAt])
  @@index([organizationId, actorMembershipId, occurredAt])
}

model Session {
  id             String                 @id @default(uuid()) @db.Uuid
  tokenHash      String                 @unique @db.VarChar(64)
  userId         String                 @db.Uuid
  organizationId String                 @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}
