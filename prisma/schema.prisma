generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  EMPLOYER_ADMIN
  EMPLOYEE
}

enum EmploymentStatus {
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum EmploymentStatusSource {
  ERPNEXT
}

enum EmployeeDirectoryProvider {
  ERPNEXT
}

enum EmployeeDirectoryAuthMethod {
  TOKEN
  OAUTH_BEARER
}

enum EmployeeDirectoryConnectionStatus {
  NOT_TESTED
  CONNECTED
  FAILED
}

enum EmployeeDirectorySyncStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum EmployeeDirectorySyncTrigger {
  MANUAL
  SCHEDULED
}

enum EmployeeDirectoryMatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
  DUPLICATE_EXTERNAL_ID
}

enum EmployeeDirectoryMatchMethod {
  UNIQUE_EMAIL
  EXPLICIT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum EmailDeliveryStatus {
  CREATED
  SENT
  FAILED
}

enum LendingOfferStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXHAUSTED
}

enum LendingOfferFundingStatus {
  LEGACY
  PENDING
  FUNDED
  FAILED
}

enum LoanStatus {
  REQUESTED
  APPROVED
  ACTIVE
  REPAID
  OVERDUE
  DEFAULTED
  CANCELLED
}

enum AuditEventType {
  LOAN_REQUESTED
  LOAN_APPROVED
  LOAN_CREATED
  LOAN_ACTIVATED
  REPAYMENT_RECORDED
  REPAYMENT_CREATED
  REPAYMENT_COMPLETED
  LOAN_REPAID
  LOAN_OVERDUE
  LOAN_DEFAULTED
  LOAN_CANCELLED
  LOAN_MARKED_OVERDUE
  LENDING_POLICY_UPDATED
  EMPLOYEE_BORROWING_SUSPENDED
  EMPLOYEE_BORROWING_ENABLED
  EMPLOYEE_LENDING_SUSPENDED
  EMPLOYEE_LENDING_ENABLED
  EMPLOYEE_DIRECTORY_SYNC_COMPLETED
  EMPLOYEE_DIRECTORY_SYNC_FAILED
  EMPLOYEE_DIRECTORY_EMPLOYEE_ADDED
  EMPLOYEE_DIRECTORY_EMPLOYEE_UPDATED
  EMPLOYEE_DIRECTORY_EMPLOYEE_REMOVED
  EMPLOYEE_DIRECTORY_EMPLOYEE_REACTIVATED
  EMPLOYEE_INVITATION_SENT
  EMPLOYEE_INVITATION_ACCEPTED
  EMPLOYEE_INVITATION_REVOKED
  PASSWORD_CHANGED
  PASSWORD_RESET
}

enum RepaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum BlockchainEventName {
  OFFER_CREATED
  LOAN_STARTED
  LOAN_REPAID
}

enum BlockchainEventStatus {
  PROVISIONAL
  APPLIED
  UNMATCHED
  CONFLICT
  REORGED
}

enum LoanDecisionClassification {
  HEALTHY
  DUE_SOON
  OVERDUE
  DEFAULT_CANDIDATE
}

enum LoanDecisionAction {
  NONE
  REMIND
  FLAG_FOR_REVIEW
  EMPLOYER_REVIEW
}

enum LoanDecisionSource {
  RULES
  MODEL
}

enum EmployerActionType {
  MARK_REVIEWED
  REQUEST_EMPLOYEE_CONTACT
  REQUEST_HR_FOLLOW_UP
}

enum EmployerActionStatus {
  PENDING
  COMPLETED
  REJECTED
  FAILED
}

enum EmployerActionProvider {
  MOCK
}

enum LedgerAccountType {
  USER_WALLET
  PLATFORM
}

enum LedgerTransactionType {
  DEPOSIT
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  WITHDRAWAL
}

enum LedgerTransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum LedgerReferenceType {
  DEVELOPMENT_FUNDING
  LOAN
  REPAYMENT
  WITHDRAWAL
}

enum LedgerEntryDirection {
  DEBIT
  CREDIT
}

enum ArcWalletNetwork {
  ARC_TESTNET
}

enum ArcWalletType {
  CIRCLE_MODULAR
}

enum ArcWalletStatus {
  PENDING
  ACTIVE
  FAILED
}

enum ArcWalletEnrollmentState {
  NOT_STARTED
  REGISTERING
  REGISTERED
  VERIFYING
  ACTIVE
  FAILED_RECOVERABLE
}

model User {
  id                  String                   @id @default(uuid()) @db.Uuid
  email               String                   @unique
  name                String
  passwordHash        String
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  memberships         OrganizationMembership[]
  arcWallets          ArcWallet[]
  arcWalletChallenges ArcWalletChallenge[]
  passwordResetTokens PasswordResetToken[]
}

model Organization {
  id                           String                              @id @default(uuid()) @db.Uuid
  name                         String
  slug                         String                              @unique
  currency                     String                              @default("USD") @db.VarChar(3)
  erpNextEnabled               Boolean                             @default(false)
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  memberships                  OrganizationMembership[]
  lendingOffers                LendingOffer[]
  loans                        Loan[]
  repayments                   LoanRepayment[]
  auditEvents                  AuditEvent[]
  balances                     EmployeeBalance[]
  ledgerAccounts               LedgerAccount[]
  ledgerTransactions           LedgerTransaction[]
  ledgerEntries                LedgerEntry[]
  lendingPolicy                OrganizationLendingPolicy?
  arcWallets                   ArcWallet[]
  arcWalletChallenges          ArcWalletChallenge[]
  loanDecisionEvaluations      LoanDecisionEvaluation[]
  loanDecisionReviews          LoanDecisionReview[]
  employerActionAttempts       EmployerActionAttempt[]
  employeeDirectoryIntegration EmployeeDirectoryIntegration?
  employeeDirectorySecrets     EmployeeDirectoryCredentialSecret[]
  employeeDirectoryMappings    EmployeeDirectoryMapping[]
  employeeDirectorySyncRuns    EmployeeDirectorySyncRun[]
  employeeInvitations          EmployeeInvitation[]
  passwordResetTokens          PasswordResetToken[]
}

model ArcWallet {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @db.Uuid
  userId          String                   @db.Uuid
  address         String?                  @unique @db.VarChar(42)
  network         ArcWalletNetwork         @default(ARC_TESTNET)
  chainId         Int                      @default(5042002)
  walletType      ArcWalletType            @default(CIRCLE_MODULAR)
  status          ArcWalletStatus          @default(PENDING)
  enrollmentState ArcWalletEnrollmentState @default(NOT_STARTED)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, network])
  @@unique([organizationId, id])
  @@index([organizationId, status])
}

model ArcWalletChallenge {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  userId         String       @db.Uuid
  address        String       @db.VarChar(42)
  nonceHash      String       @db.VarChar(64)
  expiresAt      DateTime
  consumedAt     DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, expiresAt])
}

model OrganizationMembership {
  id                        String                     @id @default(uuid()) @db.Uuid
  organizationId            String                     @db.Uuid
  userId                    String                     @db.Uuid
  role                      MembershipRole
  employmentStatus          EmploymentStatus           @default(ACTIVE)
  employmentStatusSource    EmploymentStatusSource?
  employmentStatusSyncedAt  DateTime?
  removedAt                 DateTime?
  accountActivatedAt        DateTime?
  isActive                  Boolean                    @default(true)
  canBorrow                 Boolean                    @default(true)
  canLend                   Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  organization              Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions                  Session[]
  lendingOffers             LendingOffer[]             @relation("MembershipLendingOffers")
  balance                   EmployeeBalance?
  loansAsLender             Loan[]                     @relation("LoansAsLender")
  loansAsBorrower           Loan[]                     @relation("LoansAsBorrower")
  ledgerAccounts            LedgerAccount[]
  auditEventsActed          AuditEvent[]               @relation("AuditEventActor")
  auditEventsTargeted       AuditEvent[]               @relation("AuditEventTarget")
  loanDecisionReviews       LoanDecisionReview[]       @relation("DecisionReviewsBy")
  employerActionAttempts    EmployerActionAttempt[]    @relation("EmployerActionsRequestedBy")
  employeeDirectoryMappings EmployeeDirectoryMapping[] @relation("EmployeeDirectoryMatchedMembership")
  employeeDirectorySyncRuns EmployeeDirectorySyncRun[] @relation("EmployeeDirectorySyncRequestedBy")
  employeeInvitations       EmployeeInvitation[]       @relation("EmployeeInvitationEmployee")
  invitationsCreated        EmployeeInvitation[]       @relation("EmployeeInvitationInvitedBy")
  passwordResetTokens       PasswordResetToken[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([organizationId, role])
}

model EmployeeInvitation {
  id                    String                  @id @default(uuid()) @db.Uuid
  organizationId        String                  @db.Uuid
  employeeMembershipId  String                  @db.Uuid
  email                 String                  @db.VarChar(320)
  tokenHash             String                  @unique @db.VarChar(64)
  status                InvitationStatus        @default(PENDING)
  createdAt             DateTime                @default(now())
  expiresAt             DateTime
  acceptedAt            DateTime?
  revokedAt             DateTime?
  sentAt                DateTime?
  deliveryFailureCode   String?                 @db.VarChar(64)
  deliveryStatus        EmailDeliveryStatus     @default(CREATED)
  invitedByMembershipId String?                 @db.Uuid
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeMembership    OrganizationMembership  @relation("EmployeeInvitationEmployee", fields: [organizationId, employeeMembershipId], references: [organizationId, id], onDelete: Cascade)
  invitedByMembership   OrganizationMembership? @relation("EmployeeInvitationInvitedBy", fields: [organizationId, invitedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, employeeMembershipId, status])
  @@index([expiresAt, status])
}

model PasswordResetToken {
  id                  String                 @id @default(uuid()) @db.Uuid
  organizationId      String                 @db.Uuid
  membershipId        String                 @db.Uuid
  userId              String                 @db.Uuid
  email               String                 @db.VarChar(320)
  tokenHash           String                 @unique @db.VarChar(64)
  expiresAt           DateTime
  usedAt              DateTime?
  revokedAt           DateTime?
  sentAt              DateTime?
  deliveryStatus      EmailDeliveryStatus    @default(CREATED)
  deliveryFailureCode String?                @db.VarChar(64)
  createdAt           DateTime               @default(now())
  organization        Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership          OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  user                User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, membershipId, expiresAt])
  @@index([expiresAt, usedAt, revokedAt])
}

model EmployeeDirectoryIntegration {
  id                    String                            @id @default(uuid()) @db.Uuid
  organizationId        String                            @unique @db.Uuid
  provider              EmployeeDirectoryProvider         @default(ERPNEXT)
  baseUrl               String                            @db.VarChar(512)
  apiPath               String                            @default("/api/resource") @db.VarChar(128)
  apiVersion            String                            @default("v1") @db.VarChar(16)
  authMethod            EmployeeDirectoryAuthMethod
  credentialReference   String                            @db.VarChar(128)
  timeoutMs             Int                               @default(5000)
  statusMapping         Json
  connectionStatus      EmployeeDirectoryConnectionStatus @default(NOT_TESTED)
  lastConnectionCode    String?                           @db.VarChar(64)
  lastTestedAt          DateTime?
  lastSuccessfulSyncAt  DateTime?
  lastSyncStatus        EmployeeDirectorySyncStatus?
  lastSyncErrorCode     String?                           @db.VarChar(64)
  scheduledSyncPausedAt DateTime?
  schedulePauseCode     String?                           @db.VarChar(64)
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  organization          Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mappings              EmployeeDirectoryMapping[]
  syncRuns              EmployeeDirectorySyncRun[]

  @@unique([organizationId, id])
}

model EmployeeDirectoryCredentialSecret {
  id               String                      @id @default(uuid()) @db.Uuid
  organizationId   String                      @db.Uuid
  authMethod       EmployeeDirectoryAuthMethod
  encryptedPayload String                      @db.Text
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt
  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId])
}

model EmployeeDirectoryMapping {
  id                  String                        @id @default(uuid()) @db.Uuid
  organizationId      String                        @db.Uuid
  integrationId       String                        @db.Uuid
  externalEmployeeId  String                        @db.VarChar(140)
  employeeCode        String?                       @db.VarChar(140)
  fullName            String                        @db.VarChar(280)
  email               String?                       @db.VarChar(320)
  department          String?                       @db.VarChar(280)
  designation         String?                       @db.VarChar(280)
  externalStatus      String                        @db.VarChar(128)
  normalizedStatus    EmploymentStatus?
  matchStatus         EmployeeDirectoryMatchStatus
  matchMethod         EmployeeDirectoryMatchMethod?
  matchedMembershipId String?                       @db.Uuid
  lastSynchronizedAt  DateTime
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  organization        Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration         EmployeeDirectoryIntegration  @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade)
  matchedMembership   OrganizationMembership?       @relation("EmployeeDirectoryMatchedMembership", fields: [organizationId, matchedMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, integrationId, externalEmployeeId])
  @@unique([organizationId, integrationId, matchedMembershipId])
  @@index([organizationId, matchStatus])
}

model EmployeeDirectorySyncRun {
  id                      String                       @id @default(uuid()) @db.Uuid
  organizationId          String                       @db.Uuid
  integrationId           String                       @db.Uuid
  requestedByMembershipId String?                      @db.Uuid
  trigger                 EmployeeDirectorySyncTrigger @default(MANUAL)
  status                  EmployeeDirectorySyncStatus  @default(RUNNING)
  processedCount          Int                          @default(0)
  createdCount            Int                          @default(0)
  updatedCount            Int                          @default(0)
  unchangedCount          Int                          @default(0)
  reviewCount             Int                          @default(0)
  retrievedCount          Int                          @default(0)
  matchedCount            Int                          @default(0)
  unmatchedCount          Int                          @default(0)
  ambiguousCount          Int                          @default(0)
  statusChangeCount       Int                          @default(0)
  deactivatedCount        Int                          @default(0)
  reactivatedCount        Int                          @default(0)
  invitationCreatedCount  Int                          @default(0)
  invitationSentCount     Int                          @default(0)
  invitationFailureCount  Int                          @default(0)
  errorCount              Int                          @default(0)
  safeErrorCode           String?                      @db.VarChar(64)
  safeErrorSummary        String?                      @db.VarChar(240)
  correlationId           String                       @db.Uuid
  startedAt               DateTime
  completedAt             DateTime?
  durationMs              Int?
  createdAt               DateTime                     @default(now())
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration             EmployeeDirectoryIntegration @relation(fields: [organizationId, integrationId], references: [organizationId, id], onDelete: Cascade)
  requestedByMembership   OrganizationMembership?      @relation("EmployeeDirectorySyncRequestedBy", fields: [organizationId, requestedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, startedAt])
  @@index([organizationId, trigger, startedAt])
}

model LendingOffer {
  id                          String                    @id @default(uuid()) @db.Uuid
  organizationId              String                    @db.Uuid
  lenderMembershipId          String                    @db.Uuid
  amountMinorUnits            BigInt
  availableAmountMinorUnits   BigInt
  minimumLoanAmountMinorUnits BigInt
  maximumLoanAmountMinorUnits BigInt
  currency                    String                    @db.VarChar(3)
  durationDays                Int
  feeRateBasisPoints          Int
  expiresAt                   DateTime
  status                      LendingOfferStatus
  fundingStatus               LendingOfferFundingStatus @default(LEGACY)
  fundingRequestId            String?                   @unique @db.Uuid
  lenderWalletAddress         String?                   @db.VarChar(42)
  principalBaseUnits          BigInt?
  chainOfferId                String?                   @db.VarChar(78)
  contractAddress             String?                   @db.VarChar(42)
  fundingTransactionHash      String?                   @unique @db.VarChar(66)
  fundedAt                    DateTime?
  createdAt                   DateTime                  @default(now())
  updatedAt                   DateTime                  @updatedAt
  organization                Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership            OrganizationMembership    @relation("MembershipLendingOffers", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  loans                       Loan[]
  auditEvents                 AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@index([organizationId, fundingStatus, status])
  @@index([organizationId, status, expiresAt])
  @@index([organizationId, lenderMembershipId])
}

model EmployeeBalance {
  id               String                 @id @default(uuid()) @db.Uuid
  organizationId   String                 @db.Uuid
  membershipId     String                 @db.Uuid
  amountMinorUnits BigInt
  currency         String                 @db.VarChar(3)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership       OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, membershipId])
  @@index([organizationId])
}

model Loan {
  id                             String                   @id @default(uuid()) @db.Uuid
  organizationId                 String                   @db.Uuid
  lenderMembershipId             String                   @db.Uuid
  borrowerMembershipId           String                   @db.Uuid
  lendingOfferId                 String?                  @db.Uuid
  borrowRequestId                String?                  @unique @db.Uuid
  chainLoanId                    String?                  @db.VarChar(78)
  chainOfferId                   String?                  @db.VarChar(78)
  contractAddress                String?                  @db.VarChar(42)
  lenderWalletAddress            String?                  @db.VarChar(42)
  borrowerWalletAddress          String?                  @db.VarChar(42)
  principalBaseUnits             BigInt?
  repaymentBaseUnits             BigInt?
  acceptanceTransactionHash      String?                  @unique @db.VarChar(66)
  repaymentTransactionHash       String?                  @unique @db.VarChar(66)
  onChainStartedAt               DateTime?
  onChainDueAt                   DateTime?
  onChainRepaidAt                DateTime?
  principalAmountMinorUnits      BigInt
  feeAmountMinorUnits            BigInt                   @default(0)
  outstandingPrincipalMinorUnits BigInt
  currency                       String                   @db.VarChar(3)
  durationDays                   Int
  feeRateBasisPoints             Int
  status                         LoanStatus
  requestedAt                    DateTime                 @default(now())
  approvedAt                     DateTime?
  activatedAt                    DateTime?
  closedAt                       DateTime?
  startedAt                      DateTime                 @default(now())
  repaymentDueAt                 DateTime
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt
  policyVersion                  Int?
  policySnapshot                 Json?
  organization                   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lenderMembership               OrganizationMembership   @relation("LoansAsLender", fields: [organizationId, lenderMembershipId], references: [organizationId, id], onDelete: Restrict)
  borrowerMembership             OrganizationMembership   @relation("LoansAsBorrower", fields: [organizationId, borrowerMembershipId], references: [organizationId, id], onDelete: Restrict)
  lendingOffer                   LendingOffer?            @relation(fields: [organizationId, lendingOfferId], references: [organizationId, id], onDelete: Restrict)
  repayments                     LoanRepayment[]
  auditEvents                    AuditEvent[]
  decisionEvaluations            LoanDecisionEvaluation[]
  decisionReviews                LoanDecisionReview[]
  employerActionAttempts         EmployerActionAttempt[]

  @@unique([organizationId, id])
  @@unique([contractAddress, chainLoanId])
  @@index([organizationId, status])
  @@index([organizationId, repaymentDueAt])
  @@index([organizationId, lenderMembershipId])
  @@index([organizationId, borrowerMembershipId])
  @@index([organizationId, lenderMembershipId, status])
  @@index([organizationId, borrowerMembershipId, status])
  @@index([organizationId, chainOfferId])
}

model LoanDecisionEvaluation {
  id                     String                     @id @default(uuid()) @db.Uuid
  organizationId         String                     @db.Uuid
  loanId                 String                     @db.Uuid
  classification         LoanDecisionClassification
  recommendedAction      LoanDecisionAction
  reasonCodes            String[]
  source                 LoanDecisionSource
  modelVersion           String?                    @db.VarChar(64)
  evaluatedAt            DateTime
  createdAt              DateTime                   @default(now())
  organization           Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan                   Loan                       @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  reviews                LoanDecisionReview[]
  employerActionAttempts EmployerActionAttempt[]

  @@unique([organizationId, id])
  @@index([organizationId, loanId, evaluatedAt])
  @@index([organizationId, classification, evaluatedAt])
}

model LoanDecisionReview {
  id                     String                 @id @default(uuid()) @db.Uuid
  organizationId         String                 @db.Uuid
  loanId                 String                 @db.Uuid
  evaluationId           String                 @db.Uuid
  reviewedByMembershipId String                 @db.Uuid
  reviewedAt             DateTime
  createdAt              DateTime               @default(now())
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan                   Loan                   @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  evaluation             LoanDecisionEvaluation @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict)
  reviewedByMembership   OrganizationMembership @relation("DecisionReviewsBy", fields: [organizationId, reviewedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([evaluationId, reviewedByMembershipId])
  @@index([organizationId, loanId, reviewedAt])
}

model EmployerActionAttempt {
  id                      String                 @id @default(uuid()) @db.Uuid
  organizationId          String                 @db.Uuid
  loanId                  String                 @db.Uuid
  evaluationId            String                 @db.Uuid
  requestedByMembershipId String                 @db.Uuid
  action                  EmployerActionType
  status                  EmployerActionStatus   @default(PENDING)
  provider                EmployerActionProvider
  idempotencyKey          String                 @db.VarChar(128)
  adapterActionId         String?                @db.VarChar(64)
  messageCode             String                 @db.VarChar(64)
  requestedAt             DateTime
  completedAt             DateTime?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  organization            Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan                    Loan                   @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  evaluation              LoanDecisionEvaluation @relation(fields: [organizationId, evaluationId], references: [organizationId, id], onDelete: Restrict)
  requestedByMembership   OrganizationMembership @relation("EmployerActionsRequestedBy", fields: [organizationId, requestedByMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, loanId, requestedAt])
  @@index([organizationId, requestedByMembershipId, requestedAt])
}

model LedgerAccount {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  membershipId   String?                 @db.Uuid
  asset          String                  @db.VarChar(8)
  type           LedgerAccountType
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership     OrganizationMembership? @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@unique([organizationId, membershipId, asset, type])
  @@unique([organizationId, id])
  @@index([organizationId, membershipId])
}

model LedgerTransaction {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @db.Uuid
  type           LedgerTransactionType
  status         LedgerTransactionStatus @default(PENDING)
  referenceType  LedgerReferenceType
  referenceId    String                  @db.Uuid
  idempotencyKey String                  @db.VarChar(128)
  createdAt      DateTime                @default(now())
  completedAt    DateTime?
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries        LedgerEntry[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@unique([organizationId, referenceType, referenceId, type])
  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, createdAt])
}

model LedgerEntry {
  id               String               @id @default(uuid()) @db.Uuid
  organizationId   String               @db.Uuid
  transactionId    String               @db.Uuid
  accountId        String               @db.Uuid
  direction        LedgerEntryDirection
  amountMinorUnits BigInt
  asset            String               @db.VarChar(8)
  createdAt        DateTime             @default(now())
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction      LedgerTransaction    @relation(fields: [organizationId, transactionId], references: [organizationId, id], onDelete: Restrict)
  account          LedgerAccount        @relation(fields: [organizationId, accountId], references: [organizationId, id], onDelete: Restrict)

  @@unique([transactionId, accountId, direction])
  @@index([organizationId, transactionId])
  @@index([organizationId, accountId])
}

model LoanRepayment {
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  loanId             String          @db.Uuid
  repaymentRequestId String?         @unique @db.Uuid
  amountMinorUnits   BigInt
  currency           String          @db.VarChar(3)
  status             RepaymentStatus @default(COMPLETED)
  paidAt             DateTime
  completedAt        DateTime?
  createdAt          DateTime        @default(now())
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan               Loan            @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  auditEvents        AuditEvent[]

  @@unique([organizationId, id])
  @@index([organizationId, loanId, paidAt])
}

model AuditEvent {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @db.Uuid
  loanId             String?                 @db.Uuid
  lendingOfferId     String?                 @db.Uuid
  repaymentId        String?                 @db.Uuid
  actorMembershipId  String?                 @db.Uuid
  targetMembershipId String?                 @db.Uuid
  amountMinorUnits   BigInt?
  currency           String?                 @db.VarChar(3)
  type               AuditEventType
  title              String
  actorLabel         String?
  metadata           Json?
  occurredAt         DateTime
  createdAt          DateTime                @default(now())
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loan               Loan?                   @relation(fields: [organizationId, loanId], references: [organizationId, id], onDelete: Restrict)
  lendingOffer       LendingOffer?           @relation(fields: [organizationId, lendingOfferId], references: [organizationId, id], onDelete: Restrict)
  repayment          LoanRepayment?          @relation(fields: [organizationId, repaymentId], references: [organizationId, id], onDelete: Restrict)
  actorMembership    OrganizationMembership? @relation("AuditEventActor", fields: [organizationId, actorMembershipId], references: [organizationId, id], onDelete: Restrict)
  targetMembership   OrganizationMembership? @relation("AuditEventTarget", fields: [organizationId, targetMembershipId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, loanId, occurredAt])
  @@index([organizationId, lendingOfferId, occurredAt])
  @@index([organizationId, repaymentId, occurredAt])
  @@index([organizationId, actorMembershipId, occurredAt])
  @@index([organizationId, targetMembershipId, occurredAt])
}

model OrganizationLendingPolicy {
  id                           String       @id @default(uuid()) @db.Uuid
  organizationId               String       @unique @db.Uuid
  lendingEnabled               Boolean      @default(true)
  borrowingEnabled             Boolean      @default(true)
  maxLoanAmountMinorUnits      BigInt       @default(10000)
  maxOutstandingDebtMinorUnits BigInt       @default(25000)
  maxActiveLoans               Int          @default(3)
  minInterestRateBasisPoints   Int          @default(0)
  maxInterestRateBasisPoints   Int          @default(500)
  minTermDays                  Int          @default(7)
  maxTermDays                  Int          @default(60)
  policyVersion                Int          @default(1)
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt
  organization                 Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Session {
  id             String                 @id @default(uuid()) @db.Uuid
  tokenHash      String                 @unique @db.VarChar(64)
  userId         String                 @db.Uuid
  organizationId String                 @db.Uuid
  expiresAt      DateTime
  createdAt      DateTime               @default(now())
  membership     OrganizationMembership @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BlockchainReconciliationCursor {
  id                  String    @id @default(uuid()) @db.Uuid
  chainId             Int
  contractAddress     String    @db.VarChar(42)
  nextBlock           BigInt
  finalizedThrough    BigInt
  leaseOwner          String?   @db.Uuid
  leaseExpiresAt      DateTime?
  latestObservedBlock BigInt?
  lastSuccessfulAt    DateTime?
  lastFailureAt       DateTime?
  consecutiveFailures Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([chainId, contractAddress])
}

model BlockchainEvent {
  id                String                @id @default(uuid()) @db.Uuid
  chainId           Int
  contractAddress   String                @db.VarChar(42)
  blockNumber       BigInt
  blockHash         String                @db.VarChar(66)
  transactionHash   String                @db.VarChar(66)
  logIndex          Int
  name              BlockchainEventName
  status            BlockchainEventStatus @default(PROVISIONAL)
  isFinalized       Boolean               @default(false)
  payload           Json
  organizationId    String?               @db.Uuid
  matchedRecordId   String?               @db.Uuid
  investigationCode String?               @db.VarChar(64)
  investigationNote String?               @db.VarChar(240)
  observedAt        DateTime              @default(now())
  finalizedAt       DateTime?
  processedAt       DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@unique([chainId, contractAddress, transactionHash, logIndex])
  @@index([chainId, contractAddress, blockNumber])
  @@index([chainId, contractAddress, isFinalized, status, blockNumber])
  @@index([status, updatedAt])
}

model RateLimitBucket {
  id           String   @id @default(uuid()) @db.Uuid
  identityHash String   @db.VarChar(64)
  action       String   @db.VarChar(64)
  windowStart  DateTime
  requestCount Int
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([identityHash, action, windowStart])
  @@index([expiresAt])
}
