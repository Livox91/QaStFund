/// The chain is authoritative; this row records who granted what and when.
model RepaymentAgentMandate {
  id                       String                      @id @default(uuid()) @db.Uuid
  organizationId           String                      @db.Uuid
  borrowerMembershipId     String                      @db.Uuid
